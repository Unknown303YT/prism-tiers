{
  "name": "prismtiers",
  "version": "0.1.0",
  "type": "module",
  "description": "A modern tier testing discord bot for the Prism SMP.",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "build": "tsc",
    "deploy": "tsx --env-file=.env src/deploy.ts",
    "deploy:prod": "node --env-file=.env dist/deploy.js"
  },
  "keywords": [
    "discord",
    "discordjs",
    "bot",
    "minecraft",
    "smp",
    "prismsmp"
  ],
  "author": "Unknown_303YT",
  "license": "All Rights Reserved",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "discord.js": "^14.27.0",
    "mariadb": "^3.5.3",
    "redis": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
